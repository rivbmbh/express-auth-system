<div class="w-full max-w-lg mx-auto py-6">
  <!-- Register Glass Card -->
  <div
    class="glass-card rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden border border-slate-800"
  >
    <!-- Glow Overlay -->
    <div
      class="absolute -top-20 -left-20 w-48 h-48 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"
    ></div>

    <!-- Header & Title -->
    <div class="text-center mb-6">
      <div
        class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-indigo-600/20 border border-indigo-500/30 text-indigo-400 mb-3 shadow-inner"
      >
        <i data-lucide="user-plus" class="w-6 h-6"></i>
      </div>
      <h2 class="text-2xl font-bold text-white tracking-tight">
        Buat Akun Baru
      </h2>
      <p class="text-sm text-slate-400 mt-1">
        Lengkapi formulir di bawah ini untuk mendaftar
      </p>
    </div>

    <!-- Express Validator Errors Handling -->
    <% 
      let usernameError = typeof errors !== 'undefined' && Array.isArray(errors) ? errors.find(e => e.path === 'username') : null;
      let emailError = typeof errors !== 'undefined' && Array.isArray(errors) ? errors.find(e => e.path === 'email') : null;
      let passwordError = typeof errors !== 'undefined' && Array.isArray(errors) ? errors.find(e => e.path === 'password') : null;
      let confirmError = typeof errors !== 'undefined' && Array.isArray(errors) ? errors.find(e => e.path === 'passwordConfirmation') : null;
      let hasAnyError = Boolean(usernameError || emailError || passwordError || confirmError);
    %>

    <!-- Global Alert Banner -->
    <div
      id="general-alert"
      data-server-error="<%= hasAnyError ? 'true' : 'false' %>"
      class="<%= hasAnyError ? 'flex' : 'hidden' %> items-start gap-3 p-4 mb-6 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm animate-fade-in"
    >
      <i
        data-lucide="alert-triangle"
        class="w-5 h-5 text-rose-400 shrink-0 mt-0.5"
      ></i>
      <div>
        <p class="font-semibold text-rose-200">Gagal Memproses Registrasi</p>
        <p id="general-alert-msg" class="text-xs text-rose-300/90 mt-0.5">
          Silakan periksa kembali data pada formulir di bawah ini.
        </p>
      </div>
    </div>

    <!-- Interactive Error UI Toggle (For Testing / Demo UI) -->
    <div
      class="mb-6 p-3 rounded-xl bg-slate-900/80 border border-slate-800 flex items-center justify-between"
    >
      <span
        class="text-xs text-slate-400 font-medium flex items-center gap-1.5"
      >
        <i data-lucide="flask-conical" class="w-3.5 h-3.5 text-indigo-400"></i>
        Simulasi Error UI
      </span>
      <button
        type="button"
        id="toggle-demo-error"
        class="text-xs px-2.5 py-1 rounded-lg bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 font-medium transition-colors"
      >
        Tampilkan Error State
      </button>
    </div>

    <!-- Form Register -->
    <form
      action="/register"
      method="POST"
      id="register-form"
      class="space-y-4"
      novalidate
    >
      <!-- Input Username -->
      <div>
        <label
          for="username"
          class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wider"
        >
          Nama Pengguna (Username)
        </label>
        <div class="relative rounded-xl shadow-sm">
          <div
            class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400"
          >
            <i data-lucide="user" class="w-4 h-4"></i>
          </div>
          <input
            type="text"
            name="username"
            id="username"
            placeholder="johndoe"
            value="<%= typeof oldInput !== 'undefined' && oldInput.username ? oldInput.username : '' %>"
            class="w-full pl-10 pr-10 py-3 rounded-xl bg-slate-900/90 border text-sm text-white placeholder-slate-500 focus:outline-none transition-all duration-200 <%= usernameError ? 'border-rose-500 focus:border-rose-500 ring-2 ring-rose-500/20' : 'border-slate-700/80 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20' %>"
          />
          <div
            id="username-error-icon"
            class="<%= usernameError ? 'flex' : 'hidden' %> absolute inset-y-0 right-0 pr-3.5 items-center pointer-events-none text-rose-500"
          >
            <i data-lucide="alert-circle" class="w-4 h-4"></i>
          </div>
        </div>

        <!-- Error UI Helper -->
        <p
          id="username-error-text"
          class="<%= usernameError ? 'flex' : 'hidden' %> items-center gap-1.5 text-xs text-rose-400 font-medium mt-1.5"
        >
          <i data-lucide="x-circle" class="w-3.5 h-3.5 shrink-0"></i>
          <span><%= usernameError ? usernameError.msg : 'Username minimal 3 karakter.' %></span>
        </p>
      </div>

      <!-- Input Email -->
      <div>
        <label
          for="email"
          class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wider"
        >
          Alamat Email
        </label>
        <div class="relative rounded-xl shadow-sm">
          <div
            class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400"
          >
            <i data-lucide="mail" class="w-4 h-4"></i>
          </div>
          <input
            type="email"
            name="email"
            id="email"
            placeholder="nama@email.com"
            value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>"
            class="w-full pl-10 pr-10 py-3 rounded-xl bg-slate-900/90 border text-sm text-white placeholder-slate-500 focus:outline-none transition-all duration-200 <%= emailError ? 'border-rose-500 focus:border-rose-500 ring-2 ring-rose-500/20' : 'border-slate-700/80 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20' %>"
          />
          <div
            id="email-error-icon"
            class="<%= emailError ? 'flex' : 'hidden' %> absolute inset-y-0 right-0 pr-3.5 items-center pointer-events-none text-rose-500"
          >
            <i data-lucide="alert-circle" class="w-4 h-4"></i>
          </div>
        </div>

        <!-- Error UI Helper -->
        <p
          id="email-error-text"
          class="<%= emailError ? 'flex' : 'hidden' %> items-center gap-1.5 text-xs text-rose-400 font-medium mt-1.5"
        >
          <i data-lucide="x-circle" class="w-3.5 h-3.5 shrink-0"></i>
          <span><%= emailError ? emailError.msg : 'Email tidak valid atau sudah terdaftar.' %></span>
        </p>
      </div>

      <!-- Input Password -->
      <div>
        <label
          for="password"
          class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wider"
        >
          Kata Sandi
        </label>
        <div class="relative rounded-xl shadow-sm">
          <div
            class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400"
          >
            <i data-lucide="lock" class="w-4 h-4"></i>
          </div>
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Minimal 8 karakter"
            class="w-full pl-10 pr-11 py-3 rounded-xl bg-slate-900/90 border text-sm text-white placeholder-slate-500 focus:outline-none transition-all duration-200 <%= passwordError ? 'border-rose-500 focus:border-rose-500 ring-2 ring-rose-500/20' : 'border-slate-700/80 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20' %>"
          />
          <button
            type="button"
            id="toggle-password"
            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-200 transition-colors focus:outline-none"
          >
            <i data-lucide="eye" id="eye-icon-1" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- Error UI Helper -->
        <p
          id="password-error-text"
          class="<%= passwordError ? 'flex' : 'hidden' %> items-center gap-1.5 text-xs text-rose-400 font-medium mt-1.5"
        >
          <i data-lucide="x-circle" class="w-3.5 h-3.5 shrink-0"></i>
          <span><%= passwordError ? passwordError.msg : 'Password minimal 8 karakter.' %></span>
        </p>
      </div>

      <!-- Input Password Confirmation -->
      <div>
        <label
          for="passwordConfirmation"
          class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wider"
        >
          Konfirmasi Kata Sandi
        </label>
        <div class="relative rounded-xl shadow-sm">
          <div
            class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400"
          >
            <i data-lucide="shield-check" class="w-4 h-4"></i>
          </div>
          <input
            type="password"
            name="passwordConfirmation"
            id="passwordConfirmation"
            placeholder="Ulangi kata sandi Anda"
            class="w-full pl-10 pr-11 py-3 rounded-xl bg-slate-900/90 border text-sm text-white placeholder-slate-500 focus:outline-none transition-all duration-200 <%= confirmError ? 'border-rose-500 focus:border-rose-500 ring-2 ring-rose-500/20' : 'border-slate-700/80 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20' %>"
          />
          <button
            type="button"
            id="toggle-password-confirm"
            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-200 transition-colors focus:outline-none"
          >
            <i data-lucide="eye" id="eye-icon-2" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- Error UI Helper -->
        <p
          id="confirm-error-text"
          class="<%= confirmError ? 'flex' : 'hidden' %> items-center gap-1.5 text-xs text-rose-400 font-medium mt-1.5"
        >
          <i data-lucide="x-circle" class="w-3.5 h-3.5 shrink-0"></i>
          <span><%= confirmError ? confirmError.msg : 'Konfirmasi password tidak cocok!' %></span>
        </p>
      </div>

      <!-- Terms & Conditions Checkbox -->
      <div class="pt-1">
        <label class="flex items-start gap-2.5 cursor-pointer group">
          <input
            type="checkbox"
            name="terms"
            id="terms"
            class="w-4 h-4 mt-0.5 rounded border-slate-700 bg-slate-900 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-slate-900"
          />
          <span
            class="text-xs text-slate-400 group-hover:text-slate-300 transition-colors leading-normal"
          >
            Saya menyetujui
            <a href="#" class="text-indigo-400 hover:underline"
              >Syarat & Ketentuan</a
            >
            serta
            <a href="#" class="text-indigo-400 hover:underline"
              >Kebijakan Privasi</a
            >.
          </span>
        </label>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="submit-btn"
        class="w-full mt-2 py-3.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-semibold text-sm transition-all duration-200 shadow-xl shadow-indigo-600/25 hover:shadow-indigo-600/40 flex items-center justify-center gap-2 group"
      >
        <span>Daftar Sekarang</span>
        <i data-lucide="user-check" class="w-4 h-4"></i>
      </button>
    </form>

    <!-- Footer Login Link -->
    <div class="mt-6 pt-5 border-t border-slate-800/80 text-center">
      <p class="text-xs text-slate-400">
        Sudah memiliki akun?
        <a
          href="/login"
          class="font-semibold text-indigo-400 hover:text-indigo-300 transition-colors inline-flex items-center gap-1"
        >
          Masuk disini
          <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        </a>
      </p>
    </div>
  </div>
</div>

<!-- External Modular Script for Register Page -->
<script src="/js/register.js" defer></script>
